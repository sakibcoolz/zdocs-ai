# Environment overrides for the zdocs-ai agent.
# Copy to .env and set your own values as needed.

# Model string passed to the ADK (LiteLLM-compatible). Examples:
#   ADK_MODEL=gemini-2.5-flash
#   ADK_MODEL=openai/gpt-4o
#   ADK_MODEL=anthropic/claude-3-5-sonnet-latest
#   ADK_MODEL=openrouter/deepseek/deepseek-chat   # DeepSeek via OpenRouter
ADK_MODEL=gemini-2.5-flash

# Provider API keys. Set whichever your chosen model needs.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# MinIO (local dev dependency, started via `make deps-up` / docker-compose.yml).
# Not yet wired into the app's storage path (stage/ is still the only store) —
# these just configure the container and are here for local tooling (e.g. the
# mc CLI or a future MinIO-backed tools/stage_registry.py implementation).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Repository Operations Agent (agent 9)
# ---------------------------------------------------------------------------
# Everything below is optional — the agent works with no configuration at all.

# Where analysis artefacts are written (Mermaid diagrams and generated
# Markdown), namespaced per repository as <dir>/<reponame>/. Never inside
# stage/: analysis is read-only with respect to the code it analyzes.
# Default: <project>/generated-docs
ZDOCS_GENERATED_DOCS_DIR=

# The agent uses external tools when present and documented Python fallbacks
# when not — nothing here is required to start the app. Check what you have
# with `make tools-check`:
#   rg           recommended  fast file discovery + text search
#                             fallback: pure-Python walk/scan (slower)
#   git          recommended  repository metadata; also pins the cache key
#                             fallback: none — git_metadata returns an error
#   tree-sitter  recommended  real parsing for Go/Java/JS/TS (high confidence,
#                             receiver-typed calls); install with
#                             `make install-analyzers`
#                             fallback: built-in lexical analyzers (medium)
#   ast-grep     optional     fallback: built-in lexical analyzers
#   ctags        optional     fallback: built-in analyzers
#
# The agent never installs packages, never uses sudo, never runs a shell, and
# never makes network requests. Only the executables above are on the analysis
# allowlist, and `git` is further restricted to read-only subcommands.

# --- Development-validation profile (disabled by default) ------------------
# Running a repository's own tests/linters executes untrusted code, so it never
# happens on the host: it runs in a disposable container with no network, a
# read-only filesystem, dropped capabilities and CPU/memory/PID/time limits.
# Requires Docker. Invoke explicitly with `make validate REPO=... TOOL=ruff`.
#
# Image the validation container runs in. It must already be present locally —
# validation runs never pull, so an analysis request can never trigger a
# download. Pick one that carries the toolchain you want to run.
#   docker pull python:3.12-slim
ZDOCS_VALIDATION_IMAGE=python:3.12-slim
